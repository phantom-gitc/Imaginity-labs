# ============================================================
# SureNext — Production Environment Configuration
# ============================================================
# NOTE: Never commit real credentials or private keys to Git.
# Copy this file to `.env.local` for local development.

# --- Domain & SEO ---
# Public canonical production origin (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database (Optional MongoDB Persistence) ---
# If omitted, enquiries and subscribers are safely processed in memory & emailed.
# Example: mongodb+srv://<username>:<password>@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=surenext_production

# --- Transactional Email Delivery (Optional) ---
# Notifications for new project briefs and contact enquiries
# Destination inbox for incoming enquiries:
CONTACT_RECEIVER_EMAIL=hello.surenext@gmail.com

# Provider Option 1: Resend (Recommended)
RESEND_API_KEY=

# Provider Option 2: Standard SMTP (e.g. Amazon SES, Postmark, SendGrid SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SureNext <hello.surenext@gmail.com>"

# --- Security & Rate Limiting ---
# Rate limits for /api/contact (requests per window)
RATE_LIMIT_CONTACT_MAX=5
RATE_LIMIT_CONTACT_WINDOW_MS=600000

# Rate limits for /api/newsletter (requests per window)
RATE_LIMIT_NEWSLETTER_MAX=5
RATE_LIMIT_NEWSLETTER_WINDOW_MS=3600000
